# --- UCP service ---
# Port the service listens on.
UCP_PORT=4000
# Optional fixed public origin of THIS service, used inside the /.well-known/ucp
# profile. If unset, the incoming request origin is used. In production set this
# to the real https origin agents can reach.
# UCP_PUBLIC_BASE_URL=https://ucp.example.com

# --- Storefront (Intershop PWA) ---
# Human-facing storefront origin, used to build product page URLs in catalog
# results. If unset, the incoming request origin is used.
# STOREFRONT_BASE_URL=https://shop.example.com

# --- ICM REST backend ---
# Mirrors the PWA src/environments/environment*.ts. Point this at any reachable ICM.
ICM_BASE_URL=https://develop.icm.intershop.de
ICM_SERVER=INTERSHOP/rest/WFS
ICM_CHANNEL=inSPIRED-inTRONICS_Business-Site
ICM_APPLICATION=-
ICM_LOCALE=en_US
ICM_CURRENCY=USD
# Optional: locales/currencies an agent may request per call (Accept-Language /
# Accept-Currency), advertised in the /.well-known/ucp profile. Comma-separated;
# the default above is always included. Must reflect what the ICM channel serves.
# ICM_SUPPORTED_LOCALES=en_US,de_DE,fr_FR
# ICM_SUPPORTED_CURRENCIES=USD,EUR
