{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "intershop-pwa": {
      "projectType": "application",
      "cli": {
        "schematicCollections": ["intershop-schematics"]
      },
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "ish",
      "architect": {
        "build": {
          "builder": "intershop-builders:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["src/polyfills.ts", "@angular/localize/init"],
            "tsConfig": "tsconfig.app.json",
            "plugins": ["./templates/esbuild/define-build-constants.ts"],
            "assets": [
              "src/assets",
              {
                "glob": "favicon.ico",
                "input": "src/assets/themes/theme_placeholder/img/",
                "output": "/"
              }
            ],
            "styles": ["src/styles/themes/theme_placeholder/style.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles/themes/theme_placeholder"],
              "sass": {
                "silenceDeprecations": ["import"]
              }
            },
            "sourceMap": true,
            "allowedCommonJsDependencies": [
              "localforage",
              "express-http-proxy",
              "prom-client",
              "undici",
              "on-finished",
              "@elastic/ecs-pino-format",
              "pino",
              "pino-pretty",
              "js-yaml"
            ],
            "fileReplacements": [
              {
                "replace": "src/environments/environment.ts",
                "with": "src/environments/environment.theme_placeholder.ts"
              }
            ]
          },
          "defaultConfiguration": "b2b,production",
          "configurations": {
            "production": {
              "outputHashing": "all",
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.8mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "5kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "tsConfig": "tsconfig.app-no-checks.json",
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ]
            },
            "ssr": {
              "server": "src/main.server.ts",
              "ssr": {
                "entry": "src/server.ts"
              }
            },
            "b2b": {
              "theme": "b2b"
            },
            "b2c": {
              "theme": "b2c",
              "fileReplacements": [
                {
                  "replace": "src/app/pages/account/account-navigation/account-navigation.items.ts",
                  "with": "src/app/pages/account/account-navigation/account-navigation.items.b2c.ts"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "intershop-builders:dev-server",
          "options": {
            "buildTarget": "intershop-pwa:build:b2b,development"
          },
          "defaultConfiguration": "b2b",
          "configurations": {
            "b2b": {
              "buildTarget": "intershop-pwa:build:b2b,development",
              "hmr": true
            },
            "b2c": {
              "buildTarget": "intershop-pwa:build:b2c,development",
              "hmr": true
            }
          }
        },
        "extract-i18n": {
          "builder": "intershop-builders:extract-i18n",
          "options": {
            "buildTarget": "intershop-pwa:build"
          },
          "defaultConfiguration": "b2b",
          "configurations": {
            "b2b": {
              "buildTarget": "intershop-pwa:build:b2b"
            },
            "b2c": {
              "buildTarget": "intershop-pwa:build:b2c"
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "**/*.ts",
              "**/*.mts",
              "**/*.js",
              "**/*.mjs",
              "**/*.html"
            ]
          }
        }
      }
    },
    "organization-management": {
      "projectType": "application",
      "cli": {
        "schematicCollections": ["intershop-schematics"]
      },
      "root": "projects/organization-management",
      "sourceRoot": "projects/organization-management/src",
      "prefix": "ish",
      "architect": {
        "build": {
          "builder": "intershop-builders:application",
          "options": {
            "outputPath": "dist/organization-management",
            "index": "projects/organization-management/src/index.html",
            "browser": "projects/organization-management/src/main.ts",
            "polyfills": ["src/polyfills.ts"],
            "tsConfig": "projects/organization-management/tsconfig.app.json",
            "plugins": ["./templates/esbuild/define-build-constants.ts"],
            "aot": false,
            "theme": "b2b",
            "styles": ["src/styles/themes/theme_placeholder/style.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles/themes/theme_placeholder"],
              "sass": {
                "silenceDeprecations": ["import"]
              }
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets/",
                "output": "/assets/"
              }
            ],
            "scripts": [],
            "fileReplacements": [
              {
                "replace": "src/environments/environment.ts",
                "with": "src/environments/environment.theme_placeholder.ts"
              }
            ]
          }
        },
        "serve": {
          "builder": "intershop-builders:dev-server",
          "options": {
            "buildTarget": "organization-management:build",
            "hmr": true
          }
        }
      }
    },
    "requisition-management": {
      "projectType": "application",
      "cli": {
        "schematicCollections": ["intershop-schematics"]
      },
      "root": "projects/requisition-management",
      "sourceRoot": "projects/requisition-management/src",
      "prefix": "ish",
      "architect": {
        "build": {
          "builder": "intershop-builders:application",
          "options": {
            "outputPath": "dist/requisition-management",
            "index": "projects/requisition-management/src/index.html",
            "browser": "projects/requisition-management/src/main.ts",
            "polyfills": ["src/polyfills.ts"],
            "tsConfig": "projects/requisition-management/tsconfig.app.json",
            "plugins": ["./templates/esbuild/define-build-constants.ts"],
            "aot": false,
            "theme": "b2b",
            "styles": ["src/styles/themes/theme_placeholder/style.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles/themes/theme_placeholder"],
              "sass": {
                "silenceDeprecations": ["import"]
              }
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets/",
                "output": "/assets/"
              }
            ],
            "scripts": [],
            "fileReplacements": [
              {
                "replace": "src/environments/environment.ts",
                "with": "src/environments/environment.theme_placeholder.ts"
              }
            ]
          }
        },
        "serve": {
          "builder": "intershop-builders:dev-server",
          "options": {
            "buildTarget": "requisition-management:build",
            "hmr": true
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
